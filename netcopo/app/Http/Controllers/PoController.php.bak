            'grn_id' => 0,
            'note' => "PO Updated",
            'created_by' => Auth::user()->id,
            'created_at' => now()
        ]);

        return redirect('view/po/' . $request->edit_id)->with('success', 'PO updated successfully!');    
    }

    public function delete($id='')
    {
      Po::where('id',$id)->update(['delete_status'=>'1','updated_by'=>Auth::user()->id]);

      Poline::where('po_id',$id)->update(['delete_status'=>'1']);

      Pogrnlog::insert([
            'po_id' => $id,
            'grn_id' => 0,
            'note' => "PO Deleted",
            'created_by' => Auth::user()->id,
            'created_at' => now()
        ]);
      return redirect()->back();
    }

    public function printpo($id='')
    {
        $index = Po::where('id',$id)->first();
        $title=$index->po_no;
        return view('po.print',compact('index','title'));
    }
    

    

