    public function quotereport(Request $request)
    {
        $title = "Quote";
        $fromdate = date('Y-m-01');
        $todate = date('Y-m-d');
        if (!empty($request->fromdate) && !empty($request->todate)){
            $fromdate = $request->fromdate;
            $todate = $request->todate;
        }
        $todate1 = date('Y-m-d', strtotime("+1 day", strtotime($todate)));
        $customers = Customer::where('delete_status','0')->orderBy('name','asc')->get();
        $users = User::orderBy('name','asc')->get();
        $brands=Brand::where('delete_status','0')->orderBy('name','asc')->get();
        $indexes = Quoteline::whereBetween('created_at',[$fromdate, $todate]);
        $currencies = Currency::get();
        $customer_id='';
        if(!empty($request->customer_id)){
            $customer_id=$request->customer_id;
            $indexes=$indexes->whereHas('quote', function($q) use ($request)
            {
                $q->where('customer_id',$request->customer_id);

            });
        }
        $brand_id='';
        if(!empty($request->brand_id)){
            $brand_id=$request->brand_id;
            $indexes=$indexes->whereHas('quote', function($q) use ($request)
            {
                $q->where('brand_id',$request->brand_id);

            });
        }
        $user_id='';
        if(!empty($request->user_id)){
            $user_id=$request->user_id;
            $indexes=$indexes->whereHas('quote', function($q) use ($request)
            {
                $q->where('created_by',$request->user_id);

            });
        }
        $currency_id='';
        if(!empty($request->currency)){
            $currency_id=$request->currency;
            $indexes=$indexes->whereHas('quote', function($q) use ($request)
            {
                $q->where('currency_id',$request->currency);

            });
        }

        $product_val='';
        if(!empty($request->product)){
            $product_val=$request->product;
            $indexes=$indexes->where('product',$product_val);
        }
        $indexes=$indexes->where('delete_status','0')->orderBy('id','Desc')->get();

        //print_r($indexes); exit();

        return view('report.quote',compact('title','indexes','fromdate','todate','customers','customer_id','brand_id','users','user_id','brands','currencies','currency_id','product_val'));  
    }

    public function poreport(Request $request)
    {
        $title = "PO Report";
        $fromdate = date('Y-m-01');
        $todate = date('Y-m-d');
        if (!empty($request->fromdate) && !empty($request->todate)){
            $fromdate = $request->fromdate;
            $todate = $request->todate;
        }
        $todate1 = date('Y-m-d', strtotime("+1 day", strtotime($todate)));
        $vendors = Vendor::where('delete_status','0')->orderBy('name','asc')->get();
        $status = Postatus::get();
        $currencies = Currency::where('delete_status','0')->orderBy('name','asc')->get();
        $companies = Company::where('delete_status','0')->orderBy('id','Desc')->get();
        $branches = Branch::where('delete_status','0')->orderBy('id','Desc')->get();

        $indexes = Po::whereBetween('po_date',[$fromdate, $todate]);
        $vendor_id='';
        if(!empty($request->vendor_id)){
            $vendor_id=$request->vendor_id;
            $indexes=$indexes->where('vendor_id',$vendor_id);
        }

        $status_id='';
        if(!empty($request->status_id)){
            $status_id=$request->status_id;
            $indexes=$indexes->where('postatus_id',$status_id);
        }

        $priority='';
        if(!empty($request->priority)){
            $priority=$request->priority;
            $indexes=$indexes->where('priority',$priority);
        }
        $currency_id='';
        if (!empty($request->currency_id)) {
            $currency_id = $request->currency_id;

            $indexes = $indexes->whereHas('vendor', function($q) use ($currency_id) {
                $q->where('currency_id', $currency_id);
            });
        }

        $company_id='';
        if(!empty($request->company_id)){
            $company_id=$request->company_id;
            $indexes=$indexes->where('company_id',$company_id);
        }

        $branch_id='';
        if(!empty($request->branch_id)){
            $branch_id=$request->branch_id;
            $indexes=$indexes->where('branch_id',$branch_id);
        }


        $indexes=$indexes->where('delete_status','0')->orderBy('id','Desc')->get();

        return view('report.po',compact('title','indexes','fromdate','todate','vendors','vendor_id','status_id','priority','status','currencies','currency_id','companies','branches','company_id','branch_id'));  
    }

    public function polinereport(Request $request)
    {
        $title = "Po Line Report";
        $fromdate = date('Y-m-01');
        $todate = date('Y-m-d');
        if (!empty($request->fromdate) && !empty($request->todate)){
            $fromdate = $request->fromdate;
            $todate = $request->todate;
        }
        $todate1 = date('Y-m-d', strtotime("+1 day", strtotime($todate)));
        $vendors = Vendor::where('delete_status','0')->orderBy('name','asc')->get();
        $status = Postatus::get();
        $products = Product::where('delete_status','0')->orderBy('name','asc')->get();
        $indexes = Poline::whereHas('po', function($q) use ($fromdate, $todate) {
                $q->whereBetween('po_date',[$fromdate, $todate]);
            });

        $po=Po::whereBetween('po_date',[$fromdate, $todate])->get();

        $po_id='';
        if(!empty($request->po_id)){
            $po_id=$request->po_id;
            $indexes=$indexes->where('po_id',$po_id);
        }

        $product_id='';
        if(!empty($request->product_id)){
            $product_id=$request->product_id;
            $indexes=$indexes->where('product_id',$product_id);
        }

        $vendor_id='';
        if (!empty($request->vendor_id)) {
            $vendor_id = $request->vendor_id;

            $indexes = $indexes->whereHas('po', function($q) use ($vendor_id) {
                $q->where('vendor_id', $vendor_id);
            });
        }

        $status_id='';
        if (!empty($request->status_id)) {
            $status_id = $request->status_id;

            $indexes = $indexes->whereHas('po', function($q) use ($status_id) {
                $q->where('status_id', $status_id);
            });
        }

        $priority='';
        if (!empty($request->priority)) {
            $priority = $request->priority;

            $indexes = $indexes->whereHas('po', function($q) use ($priority) {
                $q->where('priority', $priority);
            });
        }

        $indexes=$indexes->where('delete_status','0')->orderBy('id','Desc')->get();

        return view('report.poline',compact('title','indexes','fromdate','todate','vendors','vendor_id','status_id','priority','status','product_id','products','po_id','po'));  
    }

